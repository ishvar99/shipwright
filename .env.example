DATABASE_URL=postgresql+psycopg://shipwright:shipwright@localhost:55432/shipwright
REDIS_URL=redis://localhost:56379/0

OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5-coder-7b-16k
LOC_MODEL=qwen2.5-coder-7b-16k
EMBED_MODEL=nomic-embed-text
KEEP_ALIVE=2m

# Shared secret between the web BFF and this API. Empty means open, which is fine for a
# loopback-only dev box. Set it (to the same value as the web app's SHIPWRIGHT_API_KEY)
# anywhere the port could be reached from elsewhere.
SHIPWRIGHT_API_KEY=

# Which tier serves the product surface: ollama (local default) or openai_compat
# (any OpenAI-chat-completions endpoint — the hosted deploy points this at Groq).
MODEL_PROVIDER=ollama
MODEL_API_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
# "low" on hosted reasoning models (gpt-oss): thinking tokens draw from the same budget
# as the structured reply. Empty = never sent.
MODEL_REASONING_EFFORT=
# Hosted-tier caps. Local defaults: test action on, 2 workers, 0.4s poll, no clone limit.
ENABLE_TEST_ACTION=true
JOB_WORKERS=2
SSE_POLL_SECONDS=0.4
MAX_CLONE_MB=0
