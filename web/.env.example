# FastAPI control plane. Read server-side only, so it never enters the client bundle.
BACKEND_URL=http://localhost:8000

# Must match the API's SHIPWRIGHT_API_KEY. Empty means the backend is not checking.
SHIPWRIGHT_API_KEY=

# Optional password gate over /app and the data routes. Unset means no gate, which is what
# the public demo deployment wants — it has no backend and nothing to protect.
SHIPWRIGHT_PASSWORD=

# GitHub OAuth, for importing private repositories. Ownership of imported repositories is
# keyed on the GitHub account id, so without these everything belongs to the local user.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Lite mode: answering when the analysis backend is unreachable ────────────────────
# Deploy the frontend free on Vercel with no backend and questions still get answered, by a
# free-tier hosted model called from OUR server (the key never reaches the browser). The real
# engine always wins when it is up — /api/lite/ask refuses while the backend answers.
#
# Any OpenAI-chat-completions-compatible endpoint works; switching provider is an env edit.
# Recommended default — Groq: no credit card, ToS permits embedding in a deployed product,
# does not train on inputs, generous daily limits, very fast. Get a key at console.groq.com.
FALLBACK_API_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=llama-3.3-70b-versatile
#
# Alternatives (same three variables):
#   Cloudflare Workers AI  https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#   Google Gemini          https://generativelanguage.googleapis.com/v1beta/openai
#     — note: the free tier trains on inputs and its terms bar serving EEA/UK/Swiss users.
#   OpenRouter             https://openrouter.ai/api/v1   (model IDs ending in :free)
#     — note: free models require opting into prompt training and publication.
