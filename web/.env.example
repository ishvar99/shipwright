# FastAPI control plane. Read server-side only, so it never enters the client bundle.
BACKEND_URL=http://localhost:8000

# Must match the API's SHIPWRIGHT_API_KEY. Empty means the backend is not checking.
SHIPWRIGHT_API_KEY=

# Optional password gate over /app and the data routes. Unset means no gate, which is what
# the public demo deployment wants — it has no backend and nothing to protect.
SHIPWRIGHT_PASSWORD=

# GitHub OAuth, for importing private repositories. Ownership of imported repositories is
# keyed on the GitHub account id, so without these everything belongs to the local user.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
