    "                    \"validate_authority=False\"",
    "                    % authority_url)",
    "            tenant_discovery_endpoint = payload['tenant_discovery_endpoint']",
    "        else:",
    "            tenant_discovery_endpoint = (",
    "                'https://{}{}{}/.well-known/openid-configuration'.format(",
